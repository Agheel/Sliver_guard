<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.angae.phishingdefender">

    <!-- 인터넷 통신 및 FCM 수신을 위한 기본 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 실제 문자 수신을 감지하기 위한 권한 -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- 안드로이드 13(API 33) 이상에서 보호자에게 알림을 보내기 위한 권한 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sliver_guard">

        <!-- 메인 대시보드 화면 -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 어르신용 피싱 경고 팝업: 잠금화면 위에서도 즉시 뜨도록 설정 -->
        <activity
            android:name=".ui.alert.AlertActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- SMS 수신 시 피싱 여부를 판별하는 리시버 -->
        <receiver
            android:name=".data.receiver.SMSReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 보호자 폰에서 피싱 경고 푸시를 받기 위한 FCM 서비스 -->
        <service
            android:name=".data.notifier.PhishingFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/guard_slate">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="테스트 모드 - 가짜 피싱 발송"
        android:textColor="@color/guard_gold"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="가짜 피싱 문자 케이스"
        android:textColor="@color/guard_silver"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSmsCase1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="케이스 1 (해외 결제)"
        android:backgroundTint="@color/guard_navy"
        android:textColor="@color/guard_off_white"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSmsCase2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="케이스 2 (기관 사칭)"
        android:backgroundTint="@color/guard_navy"
        android:textColor="@color/guard_off_white"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="가짜 피싱 URL 케이스"
        android:textColor="@color/guard_silver"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnUrlCase1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="케이스 1 (은행 사칭)"
        android:backgroundTint="@color/guard_navy"
        android:textColor="@color/guard_off_white"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnUrlCase2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="케이스 2 (택배 사칭)"
        android:backgroundTint="@color/guard_navy"
        android:textColor="@color/guard_off_white" />

</LinearLayout>
